---
import { Image } from "astro:assets";

import assembleMonitorImage from "../assets/project-media/assemblemonitor-app.png";
import renewGridImage from "../assets/project-media/renewgrid-app.png";
import callMissedImage from "../assets/project-media/callmissed-voice.png";

interface Props {
  projectId: string;
}

const { projectId } = Astro.props;

const previews = {
  assemblemonitor: {
    image: assembleMonitorImage,
    label: "Cloud infrastructure and GitOps",
    alt: "AssembleMonitor application interface",
    number: "01",
  },
  renewgrid: {
    image: renewGridImage,
    label: "CI/CD and infrastructure automation",
    alt: "RenewGrid application registration interface",
    number: "02",
  },
  callmissed: {
    image: callMissedImage,
    label: "Serverless application delivery",
    alt: "CallMissed AI Workspace voice interface",
    number: "03",
  },
};

const preview = previews[projectId as keyof typeof previews];
---

{
  preview && (
    <figure class="project-preview">
      <div class="project-preview__image">
        <Image
          src={preview.image}
          alt={preview.alt}
          widths={[360, 600, 900, 1100]}
          sizes="(max-width: 760px) calc(100vw - 36px), (max-width: 1200px) 50vw, 520px"
          format="webp"
          quality={82}
          loading="lazy"
          decoding="async"
        />
      </div>

      <figcaption class="project-preview__caption">
        <span class="project-preview__index">{preview.number} / WORK</span>
        <span class="project-preview__label">{preview.label}</span>
      </figcaption>
    </figure>
  )
}

<style>
  .project-preview {
    position: relative;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(245, 240, 233, 0.12);
    border-radius: 14px;
    background: #29242b;
    isolation: isolate;
  }

  .project-preview__image {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #332c34;
  }

  .project-preview__image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition:
      transform 650ms cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 650ms ease;
  }

  .project-preview__image::after {
    content: "";
    position: absolute;
    inset: 35% 0 0;
    pointer-events: none;
    background: linear-gradient(to bottom, transparent, rgba(23, 21, 26, 0.34));
  }

  .project-preview:hover .project-preview__image :global(img) {
    transform: scale(1.025);
  }

  .project-preview__caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    padding: 1rem 1.15rem;
  }

  .project-preview__index {
    color: #d89bb0;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.7rem;
    letter-spacing: 0.09em;
  }

  .project-preview__label {
    color: #f5f0e9;
    font-size: 0.82rem;
    line-height: 1.5;
    text-align: right;
  }

  @media (max-width: 480px) {
    .project-preview__caption {
      align-items: flex-start;
      flex-direction: column;
    }

    .project-preview__label {
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-preview__image :global(img) {
      transition: none;
    }

    .project-preview:hover .project-preview__image :global(img) {
      transform: none;
    }
  }
</style>
