---
import { Image } from 'astro:assets';
import logoSrc from '../assets/logo.svg';

const pathname = Astro.url.pathname;

const links = [
  { href: "/work/", label: "Work" },
  { href: "/about/#experience", label: "Experience" },
  { href: "/notes/", label: "Notes" },
  { href: "/resume/Aoun_MD_Resume.pdf", label: "Resume" },
];

const isActive = (href: string) => {
  if (href.endsWith(".pdf")) return false;

  const route = href.split("#")[0];

  return pathname.startsWith(route);
};
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Aoun Md., homepage">
      <span class="brand-symbol">
        <Image
          src={logoSrc}
          alt="AM monogram logo"
          width={36}
          height={36}
          loading="eager"
          style="display:block;width:100%;height:100%;object-fit:cover;"
        />
      </span>
      <span class="brand-name">AOUN MD.</span>
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a class="header-contact" href="mailto:aounmd74@gmail.com">
      Let's talk
      <span aria-hidden="true">↗</span>
    </a>

    <details class="mobile-nav">
      <summary>
        Menu <span aria-hidden="true">+</span>
      </summary>

      <nav aria-label="Mobile navigation">
        {
          links.map((link) => (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          ))
        }

        <a href="mailto:aounmd74@gmail.com">Contact</a>
      </nav>
    </details>
  </div>
</header>
