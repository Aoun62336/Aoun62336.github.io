---
import { Image } from "astro:assets";

import awsDiagram from "../assets/project-media/assemblemonitor-aws.jpeg";
import gitopsDiagram from "../assets/project-media/assemblemonitor-gitops.jpeg";
import observabilityDiagram from "../assets/project-media/assemblemonitor-observability.jpeg";

const scenes = [
  {
    id: "infrastructure",
    tab: "AWS infrastructure",
    number: "01",
    title: "How the application runs",
    description:
      "An AWS environment with public entry points, private application workloads, and managed data services.",
    image: awsDiagram,
    alt:
      "AssembleMonitor AWS architecture showing VPC networking, load balancing, private EKS workloads, RDS and supporting AWS services.",
    facts: [
      "AWS WAF and Application Load Balancer at the entry point",
      "EKS worker nodes and PostgreSQL in private subnets",
      "IAM, IRSA, security groups and S3 integration",
    ],
  },
  {
    id: "delivery",
    tab: "CI/CD and GitOps",
    number: "02",
    title: "How application changes are delivered",
    description:
      "Validation and image publication are separated from Kubernetes reconciliation.",
    image: gitopsDiagram,
    alt:
      "AssembleMonitor CI/CD and GitOps architecture showing Jenkins, security checks, Docker Hub, Git-managed Helm configuration, Argo CD and EKS.",
    facts: [
      "GitHub Actions performs pre-merge validation",
      "Jenkins builds, scans and publishes container images",
      "Argo CD reconciles the Git-managed Helm configuration to EKS",
    ],
  },
  {
    id: "observability",
    tab: "Observability",
    number: "03",
    title: "How application behavior is investigated",
    description:
      "Metrics, logs and traces provide different views of application and infrastructure behavior.",
    image: observabilityDiagram,
    alt:
      "AssembleMonitor observability architecture showing OpenTelemetry, Prometheus-compatible metrics, Loki logs, Tempo traces and Grafana.",
    facts: [
      "OpenTelemetry instrumentation and collection",
      "Prometheus-compatible metrics, Loki logs and Tempo traces",
      "Grafana dashboards and controlled reliability exercises",
    ],
  },
] as const;
---

<section
  class="architecture-explorer section section-border"
  data-architecture-explorer
  aria-labelledby="architecture-explorer-title"
>
  <div class="container">
    <div class="architecture-explorer__intro" data-reveal>
      <p class="eyebrow">02 / INTERACTIVE ENGINEERING</p>

      <h2 id="architecture-explorer-title">
        Explore the systems
        <span class="serif-accent">behind the application.</span>
      </h2>

      <p>
        AssembleMonitor brings infrastructure, application delivery,
        and observability into one engineering project.
        Select a view to examine the architecture and the decisions
        behind it.
      </p>
    </div>

    <div
      class="architecture-explorer__tabs"
      role="tablist"
      aria-label="Explore AssembleMonitor architecture"
    >
      {
        scenes.map((scene, index) => (
          <button
            id={`architecture-tab-${scene.id}`}
            class="architecture-explorer__tab"
            type="button"
            role="tab"
            aria-controls={`architecture-panel-${scene.id}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
            data-architecture-tab
          >
            <span class="architecture-explorer__tab-number">
              {scene.number}
            </span>
            {scene.tab}
          </button>
        ))
      }
    </div>

    <div class="architecture-explorer__panels">
      {
        scenes.map((scene) => (
          <section
            id={`architecture-panel-${scene.id}`}
            class="architecture-explorer__panel"
            role="tabpanel"
            tabindex="0"
            aria-labelledby={`architecture-tab-${scene.id}`}
            data-architecture-panel
          >
            <div class="architecture-explorer__visual">
              <div class="architecture-explorer__visual-top">
                <span>ASSEMBLEMONITOR</span>
                <span>{scene.number} / SYSTEM VIEW</span>
              </div>

              <a
                href={scene.image.src}
                target="_blank"
                rel="noopener noreferrer"
                class="architecture-explorer__image-link"
                aria-label={`Open full-size ${scene.tab} diagram`}
              >
                <Image
                  src={scene.image}
                  alt={scene.alt}
                  widths={[480, 800, 1200, 1600]}
                  sizes="(max-width: 760px) 100vw, 1100px"
                  format="webp"
                  quality={82}
                  loading="lazy"
                  decoding="async"
                />
              </a>

              <div class="architecture-explorer__visual-bottom">
                <span>Source-backed engineering diagram</span>
                <a
                  href={scene.image.src}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Open full diagram ↗
                </a>
              </div>
            </div>

            <div class="architecture-explorer__details">
              <p class="eyebrow">
                {scene.number} / ARCHITECTURE EXPLAINED
              </p>

              <h3>{scene.title}</h3>

              <p class="architecture-explorer__description">
                {scene.description}
              </p>

              <ul>
                {
                  scene.facts.map((fact) => (
                    <li>{fact}</li>
                  ))
                }
              </ul>

              <a
                class="architecture-explorer__case-link"
                href="/work/assemblemonitor/"
              >
                Read the full case study
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </section>
        ))
      }
    </div>
  </div>
</section>

<script>
  function initializeArchitectureExplorer(root: HTMLElement) {
    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>(
        "[data-architecture-tab]",
      ),
    );

    const panels = Array.from(
      root.querySelectorAll<HTMLElement>(
        "[data-architecture-panel]",
      ),
    );

    if (tabs.length === 0 || tabs.length !== panels.length) {
      return;
    }

    const activateTab = (index: number, moveFocus = false) => {
      tabs.forEach((tab, position) => {
        const selected = position === index;

        tab.setAttribute(
          "aria-selected",
          selected ? "true" : "false",
        );

        tab.tabIndex = selected ? 0 : -1;

        panels[position].hidden = !selected;
      });

      if (moveFocus) {
        tabs[index].focus();
      }
    };

    // Without JavaScript all views remain readable.
    // Once enhanced, only the selected panel is displayed.
    root.dataset.enhanced = "true";

    activateTab(0);

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        activateTab(index);
      });

      tab.addEventListener("keydown", (event) => {
        let nextIndex = index;

        switch (event.key) {
          case "ArrowRight":
            nextIndex = (index + 1) % tabs.length;
            break;

          case "ArrowLeft":
            nextIndex = (index - 1 + tabs.length) % tabs.length;
            break;

          case "Home":
            nextIndex = 0;
            break;

          case "End":
            nextIndex = tabs.length - 1;
            break;

          default:
            return;
        }

        event.preventDefault();
        activateTab(nextIndex, true);
      });
    });
  }

  document
    .querySelectorAll<HTMLElement>("[data-architecture-explorer]")
    .forEach(initializeArchitectureExplorer);
</script>

<style>
  .architecture-explorer {
    overflow: hidden;
  }

  .architecture-explorer__intro {
    max-width: 820px;
    margin-bottom: 40px;
  }

  .architecture-explorer__intro h2 {
    margin: 18px 0 22px;
    font-size: clamp(2.5rem, 5.6vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.07em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .architecture-explorer__intro > p:last-child {
    max-width: 680px;
    color: var(--muted);
    line-height: 1.8;
  }

  .architecture-explorer__tabs {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding: 3px 3px 18px;
    scrollbar-width: thin;
    scrollbar-color: var(--plum) transparent;
  }

  .architecture-explorer__tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    min-height: 52px;
    padding: 12px 20px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    color: var(--muted);
    font: inherit;
    font-size: 0.89rem;
    cursor: pointer;
    white-space: nowrap;
  }

  .architecture-explorer__tab-number {
    color: var(--sage);
    font-family: var(--font-mono);
    font-size: 0.67rem;
  }

  .architecture-explorer__tab[aria-selected="true"] {
    border-color: var(--plum);
    background: var(--plum);
    color: var(--bg);
    font-weight: 600;
  }

  .architecture-explorer__tab[aria-selected="true"]
  .architecture-explorer__tab-number {
    color: var(--bg);
  }

  .architecture-explorer__tab:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 3px;
  }

  .architecture-explorer__panels {
    margin-top: 10px;
  }

  .architecture-explorer__panel {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(260px, 0.7fr);
    gap: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--surface);
  }

  .architecture-explorer__panel[hidden] {
    display: none;
  }

  .architecture-explorer:not([data-enhanced])
  .architecture-explorer__panel + .architecture-explorer__panel {
    margin-top: 20px;
  }

  .architecture-explorer__visual {
    min-width: 0;
    padding: 20px;
    border-right: 1px solid var(--line);
    background: #211e24;
  }

  .architecture-explorer__visual-top,
  .architecture-explorer__visual-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    color: var(--sage);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
  }

  .architecture-explorer__visual-top {
    margin-bottom: 18px;
  }

  .architecture-explorer__visual-bottom {
    margin-top: 16px;
  }

  .architecture-explorer__visual-bottom a {
    color: var(--plum);
  }

  .architecture-explorer__image-link {
    display: block;
    overflow: hidden;
    border: 1px solid rgba(245, 240, 233, 0.15);
    border-radius: 10px;
    background: #f5f2ed;
  }

  .architecture-explorer__image-link :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 530px;
    margin-inline: auto;
    object-fit: contain;
  }

  .architecture-explorer__details {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: clamp(24px, 3vw, 42px);
  }

  .architecture-explorer__details h3 {
    margin: 12px 0 17px;
    font-size: clamp(1.6rem, 2.7vw, 2.3rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1.15;
  }

  .architecture-explorer__description {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .architecture-explorer__details ul {
    display: grid;
    gap: 16px;
    padding: 0;
    margin: 17px 0 32px;
    list-style: none;
  }

  .architecture-explorer__details li {
    position: relative;
    padding-left: 19px;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.6;
  }

  .architecture-explorer__details li::before {
    position: absolute;
    top: 0.66em;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sage);
    content: "";
  }

  .architecture-explorer__case-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    width: fit-content;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--plum);
    color: var(--text);
    font-size: 0.86rem;
    font-weight: 600;
  }

  .architecture-explorer__case-link span {
    color: var(--plum);
  }

  @media (prefers-reduced-motion: no-preference) {
    .architecture-explorer__tab,
    .architecture-explorer__case-link {
      transition:
        color 180ms ease,
        background-color 180ms ease,
        border-color 180ms ease;
    }

    @keyframes architecture-enter {
      from {
        opacity: 0.5;
        transform: translateY(8px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .architecture-explorer[data-enhanced]
    .architecture-explorer__panel:not([hidden]) {
      animation: architecture-enter 280ms ease both;
    }
  }

  @media (max-width: 920px) {
    .architecture-explorer__panel {
      grid-template-columns: 1fr;
    }

    .architecture-explorer__visual {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }

  @media (max-width: 600px) {
    .architecture-explorer__intro {
      margin-bottom: 27px;
    }

    .architecture-explorer__tab {
      min-height: 48px;
      padding: 11px 14px;
      font-size: 0.8rem;
    }

    .architecture-explorer__visual {
      padding: 12px;
    }

    .architecture-explorer__visual-top,
    .architecture-explorer__visual-bottom {
      font-size: 0.57rem;
    }

    .architecture-explorer__details {
      padding: 24px 20px;
    }

    .architecture-explorer__details ul {
      margin-bottom: 24px;
    }
  }
</style>