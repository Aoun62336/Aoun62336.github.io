---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import assembleAws from "../assets/project-media/assemblemonitor-aws.jpeg";
import assembleGitops from "../assets/project-media/assemblemonitor-gitops.jpeg";
import assembleObservability from "../assets/project-media/assemblemonitor-observability.jpeg";

import renewGridApp from "../assets/project-media/renewgrid-app.png";
import callMissedVoice from "../assets/project-media/callmissed-voice.png";

interface Props {
  projectId: string;
}

interface EvidenceItem {
  image: ImageMetadata;
  title: string;
  description: string;
  alt: string;
}

const { projectId } = Astro.props;

const galleries: Record<string, EvidenceItem[]> = {
  assemblemonitor: [
    {
      image: assembleAws,
      title: "AWS infrastructure",
      description:
        "Network layout, application routing, EKS workloads, database access and supporting AWS services. The diagram includes some historical supporting infrastructure.",
      alt: "AssembleMonitor AWS architecture with VPC boundaries, public and private subnets, load balancer, EKS, RDS and supporting services.",
    },
    {
      image: assembleGitops,
      title: "CI/CD and GitOps",
      description:
        "Jenkins validation and image publishing, followed by the primary GitOps path through GitHub and Argo CD. A separate K3s deployment path is also shown.",
      alt: "AssembleMonitor CI/CD diagram showing Jenkins, code and image checks, Docker Hub, a GitOps repository, Argo CD, EKS and a separate K3s path.",
    },
    {
      image: assembleObservability,
      title: "Metrics, logs and traces",
      description:
        "Telemetry collection using OpenTelemetry, with Prometheus-compatible metrics, Loki logs, Tempo traces and Grafana visualization.",
      alt: "AssembleMonitor observability diagram showing telemetry sources, an OpenTelemetry collector, Loki, Tempo, Amazon Managed Prometheus and Grafana.",
    },
  ],

  renewgrid: [
    {
      image: renewGridApp,
      title: "RenewGrid application",
      description:
        "A screenshot from the full-stack application. The related engineering work covers automated validation, container publication, Compose deployment and Terraform provisioning.",
      alt: "RenewGrid application registration screen.",
    },
  ],

  callmissed: [
    {
      image: callMissedVoice,
      title: "Browser voice workspace",
      description:
        "The application interface during a browser voice session. The case study explains the application architecture and the separate serverless delivery workflow.",
      alt: "CallMissed AI Workspace voice interface showing an active browser conversation.",
    },
  ],
};

const items = galleries[projectId] ?? [];
const headingId = `engineering-evidence-${projectId}`;
---

{
  items.length > 0 && (
    <section class="engineering-evidence" aria-labelledby={headingId}>
      <div class="engineering-evidence__heading">
        <p class="engineering-evidence__eyebrow">VISUAL EVIDENCE</p>
        <h2 id={headingId}>Inside the engineering work</h2>
        <p>
          Selected diagrams and screenshots from the project repositories. Open
          an image to inspect its original details.
        </p>
      </div>

      <div class="engineering-evidence__list">
        {items.map((item, index) => (
          <figure class="engineering-evidence__item">
            <div class="engineering-evidence__topline">
              <span>
                {String(index + 1).padStart(2, "0")} /{" "}
                {String(items.length).padStart(2, "0")}
              </span>
              <span>PROJECT RECORD</span>
            </div>

            <a
              class="engineering-evidence__image-link"
              href={item.image.src}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Open full-resolution image: ${item.title}`}
            >
              <Image
                src={item.image}
                alt={item.alt}
                width={1440}
                format="webp"
                quality={85}
                loading="lazy"
                decoding="async"
              />
            </a>

            <figcaption class="engineering-evidence__caption">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <a
                href={item.image.src}
                target="_blank"
                rel="noopener noreferrer"
              >
                View original image
              </a>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )
}

<style>
  .engineering-evidence {
    margin-block: clamp(4rem, 8vw, 7rem);
  }

  .engineering-evidence__heading {
    max-width: 720px;
    margin-bottom: 2rem;
  }

  .engineering-evidence__eyebrow {
    margin: 0 0 0.9rem;
    color: #d89bb0;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.74rem;
    letter-spacing: 0.12em;
  }

  .engineering-evidence__heading h2 {
    margin: 0 0 0.9rem;
    color: #f5f0e9;
    font-size: clamp(1.85rem, 4vw, 3.1rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .engineering-evidence__heading > p:last-child {
    color: #c7c0c7;
    line-height: 1.75;
  }

  .engineering-evidence__list {
    display: grid;
    gap: 2.5rem;
  }

  .engineering-evidence__item {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(245, 240, 233, 0.12);
    border-radius: 18px;
    background: #29242b;
  }

  .engineering-evidence__topline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid rgba(245, 240, 233, 0.1);
    color: #d89bb0;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.69rem;
    letter-spacing: 0.08em;
  }

  .engineering-evidence__image-link {
    display: block;
    padding: clamp(0.6rem, 2vw, 1.5rem);
    background: #e9e7e5;
    cursor: zoom-in;
  }

  .engineering-evidence__image-link :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 780px;
    object-fit: contain;
    margin: 0 auto;
  }

  .engineering-evidence__image-link:focus-visible {
    outline: 3px solid #d89bb0;
    outline-offset: -4px;
  }

  .engineering-evidence__caption {
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .engineering-evidence__caption h3 {
    margin: 0 0 0.7rem;
    color: #f5f0e9;
    font-size: clamp(1.2rem, 2.5vw, 1.7rem);
  }

  .engineering-evidence__caption p {
    max-width: 780px;
    margin: 0 0 1rem;
    color: #c7c0c7;
    line-height: 1.75;
  }

  .engineering-evidence__caption a {
    color: #d89bb0;
    font-size: 0.9rem;
    text-underline-offset: 4px;
  }

  .engineering-evidence__caption a:hover {
    color: #f5f0e9;
  }

  @media (max-width: 640px) {
    .engineering-evidence__topline {
      font-size: 0.6rem;
    }

    .engineering-evidence__image-link {
      padding: 0.5rem;
    }
  }
</style>
