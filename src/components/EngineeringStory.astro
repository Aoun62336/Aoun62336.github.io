---
interface EvidenceLink {
  label: string;
  url: string;
}

interface Story {
  title: string;
  problem: string;
  built: string;
  reason: string;
  verification: string;
  limitation: string;
  evidence: EvidenceLink[];
}

interface Props {
  projectId: string;
}

const { projectId } = Astro.props;

const stories: Record<string, Story> = {
  assemblemonitor: {
    title: "AssembleMonitor",

    problem:
      "The construction management application needed a documented AWS deployment model, automated container delivery, security boundaries, and ways to investigate workload behavior.",

    built:
      "Independently defined AWS infrastructure and EKS workloads with Terraform, implemented Jenkins release preparation and Argo CD reconciliation, and configured Kubernetes security and observability components.",

    reason:
      "Terraform makes infrastructure changes reviewable. GitOps separates image publication from deployment reconciliation. Workload identity, network boundaries, and separate telemetry backends address different operational concerns.",

    verification:
      "The repository records infrastructure validation, pipeline execution, Argo CD synchronization, health checks, and controlled database, API, and DNS-failure exercises in a separate local Docker Compose environment.",

    limitation:
      "The Terraform deployment reused the AWS default VPC. Local Compose fault-drill results do not establish EKS recovery behavior, and configured telemetry components do not by themselves prove complete production monitoring coverage.",

    evidence: [
      {
        label: "AWS architecture",
        url: "https://github.com/Aoun62336/AssembleMonitor-DevOps/blob/main/docs/architecture/ARCHITECTURE.md",
      },
      {
        label: "CI/CD and GitOps",
        url: "https://github.com/Aoun62336/AssembleMonitor-DevOps/blob/main/docs/ops/CI_CD_PIPELINE.md",
      },
      {
        label: "Jenkins pipeline source",
        url: "https://github.com/Aoun62336/AssembleMonitor-DevOps/blob/main/Jenkinsfile-gitops",
      },
    ],
  },

  renewgrid: {
    title: "RenewGrid",

    problem:
      "RenewGrid, an e-waste management application, needed repeatable validation and delivery workflows. I used the same application to investigate CI failures, container security findings, deployment dependencies, and infrastructure lifecycle management.",

    built:
      "Implemented separate GitHub Actions and Jenkins delivery paths, published images to GHCR and Docker Hub, verified Compose deployments, and managed a local Compose project with Terraform's Docker provider.",

    reason:
      "GitHub Actions provided repository-native automation, while Jenkins provided experience with a self-managed EC2 build environment. Compose matched the application's deployment scope, and Terraform demonstrated declarative management of the local environment.",

    verification:
      "The October 24, 2026 Jenkins Build #7 record shows 26 passing backend tests, frontend validation, configured security gates, SBOM generation, image publication, and deployment checks. Terraform records document planning, applying, reconciliation, and teardown.",

    limitation:
      "The three delivery implementations are separate. The Terraform project manages local Docker Compose resources, not AWS infrastructure. Recorded test and scan results apply to their specific executions.",

    evidence: [
      {
        label: "Jenkins execution evidence",
        url: "https://github.com/Aoun62336/RenewGrid-Terraform-IaC/blob/main/evidence/jenkins/jenkins-verification.md",
      },
      {
        label: "Terraform configuration",
        url: "https://github.com/Aoun62336/RenewGrid-Terraform-IaC/blob/main/terraform/main.tf",
      },
      {
        label: "Terraform execution records",
        url: "https://github.com/Aoun62336/RenewGrid-Terraform-IaC/tree/main/evidence/terraform/renewgrid",
      },
      {
        label: "GitHub Actions CI",
        url: "https://github.com/Aoun62336/RenewGrid-DevOps/blob/main/.github/workflows/renewgrid-cicd.yml",
      },
    ],
  },

  callmissed: {
    title: "CallMissed AI Workspace",

    problem:
      "The AI workspace needed a controlled way to access external provider services, manage paid requests and secrets, and deploy the backend without maintaining a dedicated application server.",

    built:
      "Implemented React and FastAPI application integration, AWS Lambda container deployment, Terraform infrastructure, GitHub OIDC authentication, ECR image publication, access controls, health checks, and previous-image rollback logic.",

    reason:
      "Expected traffic was low and intermittent, making Lambda suitable for the deployment model. The application did not require a persistent database or private VPC resources. OIDC avoided long-lived AWS deployment keys, and immutable image references improved traceability.",

    verification:
      "The project records 19 passing backend tests, provider smoke checks, and a previous-image rollback and restoration exercise. The automated health-failure rollback branch is implemented in the workflow, but the cited exercise does not establish that this exact failure-triggered branch was executed.",

    limitation:
      "The workspace depends on an external AI provider. Access protection is application-level, ambiguous paid requests are not automatically retried, and the implemented rollback path does not cover every possible deployment or runtime failure.",

    evidence: [
      {
        label: "Verification records",
        url: "https://github.com/Aoun62336/CallMissed-Ai-Workspace/blob/main/docs/TEST_EVIDENCE.md",
      },
      {
        label: "Engineering decisions",
        url: "https://github.com/Aoun62336/CallMissed-Ai-Workspace/blob/main/docs/DECISIONS.md",
      },
      {
        label: "Deployment workflow",
        url: "https://github.com/Aoun62336/CallMissed-Ai-Workspace/blob/main/.github/workflows/deploy.yml",
      },
    ],
  },
};

const story = stories[projectId];

const questions = story
  ? [
      {
        number: "01",
        title: "What problem needed solving?",
        answer: story.problem,
      },
      { number: "02", title: "What did I build?", answer: story.built },
      { number: "03", title: "Why this approach?", answer: story.reason },
      {
        number: "04",
        title: "How was it verified?",
        answer: story.verification,
      },
      {
        number: "05",
        title: "What are the limitations?",
        answer: story.limitation,
      },
    ]
  : [];
---

{
  story && (
    <section
      id="engineering-summary"
      class="engineering-story"
      aria-labelledby="engineering-story-title"
    >
      <div class="engineering-story__intro">
        <p class="eyebrow">ENGINEERING BREAKDOWN</p>
        <h2 id="engineering-story-title">
          The problem, decisions, and evidence.
        </h2>
        <p>
          A concise explanation of the work behind {story.title}, including what
          was verified and where the implementation can be inspected.
        </p>
      </div>

      <div class="engineering-story__grid">
        {questions.map((question) => (
          <section class="engineering-story__item">
            <span class="engineering-story__number">{question.number}</span>

            <h3>{question.title}</h3>
            <p>{question.answer}</p>
          </section>
        ))}
      </div>

      <div class="engineering-story__sources">
        <h3>Inspect the implementation</h3>

        <div class="engineering-story__links">
          {story.evidence.map((item) => (
            <a href={item.url} target="_blank" rel="noopener noreferrer">
              {item.label}
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .engineering-story {
    margin-block: 64px;
  }

  .engineering-story__intro {
    max-width: 780px;
    margin-bottom: 28px;
  }

  .engineering-story__intro h2 {
    margin: 12px 0 16px;
    font-size: clamp(1.9rem, 4vw, 3.3rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1.13;
  }

  .engineering-story__intro > p:last-child {
    color: var(--muted);
    line-height: 1.75;
  }

  .engineering-story__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .engineering-story__item {
    min-width: 0;
    padding: clamp(20px, 2.5vw, 30px);
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }

  .engineering-story__number {
    color: var(--sage);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .engineering-story__item h3 {
    margin: 20px 0 12px;
    font-size: 1.17rem;
    font-weight: 550;
    letter-spacing: -0.025em;
  }

  .engineering-story__item p {
    margin: 0;
    color: var(--muted);
    font-size: 0.91rem;
    line-height: 1.75;
  }

  .engineering-story__sources {
    margin-top: 14px;
    padding: 24px;
    border: 1px solid rgba(216, 155, 176, 0.3);
    border-radius: 12px;
    background: #211d24;
  }

  .engineering-story__sources h3 {
    margin: 0 0 16px;
    font-size: 1rem;
    font-weight: 550;
  }

  .engineering-story__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .engineering-story__links a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--text);
    font-size: 0.83rem;
    line-height: 1.4;
  }

  .engineering-story__links a:hover,
  .engineering-story__links a:focus-visible {
    border-color: var(--plum);
    background: rgba(216, 155, 176, 0.1);
  }

  .engineering-story__links a span {
    color: var(--plum);
  }

  @media (max-width: 650px) {
    .engineering-story {
      margin-block: 45px;
    }

    .engineering-story__grid {
      grid-template-columns: 1fr;
    }

    .engineering-story__item {
      padding: 20px;
    }

    .engineering-story__sources {
      padding: 18px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .engineering-story__links a {
      transition:
        background-color 180ms ease,
        border-color 180ms ease;
    }
  }
</style>
