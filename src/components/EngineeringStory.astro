---
interface EvidenceLink {
  label: string;
  url: string;
}

interface Story {
  title: string;
  problem: string;
  built: string;
  reason: string;
  verification: string;
  limitation: string;
  evidence: EvidenceLink[];
}

interface Props {
  projectId: string;
}

const { projectId } = Astro.props;

const stories: Record<string, Story> = {
  assemblemonitor: {
    title: "AssembleMonitor",

    problem:
      "The application needed a repeatable way to provision its cloud infrastructure, deliver container changes, and investigate workload behavior.",

    built:
      "Terraform-managed AWS infrastructure, EKS workloads, a Jenkins release pipeline, GitOps reconciliation through Argo CD, and an observability stack.",

    reason:
      "Terraform keeps infrastructure definitions reviewable. GitOps separates image publication from cluster deployment. Metrics, logs, and traces provide complementary operational evidence.",

    verification:
      "The repository contains architecture records, pipeline evidence, Argo CD synchronization screenshots, health checks, and controlled operational exercises.",

    limitation:
      "The AWS deployment was a documented engineering implementation, not a claim of continuously running production availability.",

    evidence: [
      {
        label: "AWS architecture",
        url: "https://github.com/Aoun62336/AssembleMonitor-DevOps/blob/main/docs/architecture/ARCHITECTURE.md",
      },
      {
        label: "CI/CD and GitOps",
        url: "https://github.com/Aoun62336/AssembleMonitor-DevOps/blob/main/docs/ops/CI_CD_PIPELINE.md",
      },
      {
        label: "Jenkins pipeline source",
        url: "https://github.com/Aoun62336/AssembleMonitor-DevOps/blob/main/Jenkinsfile-gitops",
      },
    ],
  },

  renewgrid: {
    title: "RenewGrid",

    problem:
      "The same full-stack application needed reliable validation, container publication, and repeatable deployment across different engineering workflows.",

    built:
      "GitHub Actions and Jenkins pipelines, GHCR and Docker Hub image publication, Compose-based verification, and a Terraform-managed local deployment.",

    reason:
      "The workflows demonstrate repository-native and self-managed CI/CD separately. Docker Compose fits the application's deployment scope, while Terraform provides declarative lifecycle management.",

    verification:
      "Jenkins Build #7 succeeded on October 24, 2026. The documented run includes 26 passing backend tests, security checks, SBOM generation, image publication, and deployment verification.",

    limitation:
      "The GitHub Actions, Jenkins, and Terraform paths are separate implementations. Terraform manages local Docker resources, not AWS infrastructure.",

    evidence: [
      {
        label: "Jenkins execution evidence",
        url: "https://github.com/Aoun62336/RenewGrid-Terraform-IaC/blob/main/evidence/jenkins/jenkins-verification.md",
      },
      {
        label: "Terraform configuration",
        url: "https://github.com/Aoun62336/RenewGrid-Terraform-IaC/blob/main/terraform/main.tf",
      },
      {
        label: "Terraform execution records",
        url: "https://github.com/Aoun62336/RenewGrid-Terraform-IaC/tree/main/evidence/terraform/renewgrid",
      },
      {
        label: "GitHub Actions CI",
        url: "https://github.com/Aoun62336/RenewGrid-DevOps/blob/main/.github/workflows/renewgrid-cicd.yml",
      },
    ],
  },

  callmissed: {
    title: "CallMissed AI Workspace",

    problem:
      "The application needed a deployable backend for external AI services while controlling credentials, paid API usage, and deployment failures without maintaining a dedicated application server.",

    built:
      "A React and FastAPI application packaged for AWS Lambda, Terraform infrastructure, GitHub OIDC deployment, ECR images, reviewer access controls, and health-based rollback.",

    reason:
      "Lambda reduces server management for this deployment model. OIDC avoids long-lived AWS deployment keys. Immutable image digests and recorded previous images support traceable releases and recovery.",

    verification:
      "The project records 19 passing backend tests, health checks, chat/image/voice smoke tests, and a successful rollback and restoration drill.",

    limitation:
      "External AI operations depend on provider access. The reviewer gate is an application-level control, and the rollback mechanism does not cover every possible failure.",

    evidence: [
      {
        label: "Verification records",
        url: "https://github.com/Aoun62336/CallMissed-Ai-Workspace/blob/main/docs/TEST_EVIDENCE.md",
      },
      {
        label: "Engineering decisions",
        url: "https://github.com/Aoun62336/CallMissed-Ai-Workspace/blob/main/docs/DECISIONS.md",
      },
      {
        label: "Deployment workflow",
        url: "https://github.com/Aoun62336/CallMissed-Ai-Workspace/blob/main/.github/workflows/deploy.yml",
      },
    ],
  },
};

const story = stories[projectId];

const questions = story
  ? [
      {
        number: "01",
        title: "What problem needed solving?",
        answer: story.problem,
      },
      { number: "02", title: "What did I build?", answer: story.built },
      { number: "03", title: "Why this approach?", answer: story.reason },
      {
        number: "04",
        title: "How was it verified?",
        answer: story.verification,
      },
      {
        number: "05",
        title: "What are the limitations?",
        answer: story.limitation,
      },
    ]
  : [];
---

{
  story && (
    <section
      id="engineering-summary"
      class="engineering-story"
      aria-labelledby="engineering-story-title"
    >
      <div class="engineering-story__intro">
        <p class="eyebrow">ENGINEERING BREAKDOWN</p>
        <h2 id="engineering-story-title">
          The problem, decisions, and evidence.
        </h2>
        <p>
          A concise explanation of the work behind {story.title}, including what
          was verified and where the implementation can be inspected.
        </p>
      </div>

      <div class="engineering-story__grid">
        {questions.map((question) => (
          <section class="engineering-story__item">
            <span class="engineering-story__number">{question.number}</span>

            <h3>{question.title}</h3>
            <p>{question.answer}</p>
          </section>
        ))}
      </div>

      <div class="engineering-story__sources">
        <h3>Inspect the implementation</h3>

        <div class="engineering-story__links">
          {story.evidence.map((item) => (
            <a href={item.url} target="_blank" rel="noopener noreferrer">
              {item.label}
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .engineering-story {
    margin-block: 64px;
  }

  .engineering-story__intro {
    max-width: 780px;
    margin-bottom: 28px;
  }

  .engineering-story__intro h2 {
    margin: 12px 0 16px;
    font-size: clamp(1.9rem, 4vw, 3.3rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1.13;
  }

  .engineering-story__intro > p:last-child {
    color: var(--muted);
    line-height: 1.75;
  }

  .engineering-story__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .engineering-story__item {
    min-width: 0;
    padding: clamp(20px, 2.5vw, 30px);
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }

  .engineering-story__number {
    color: var(--sage);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .engineering-story__item h3 {
    margin: 20px 0 12px;
    font-size: 1.17rem;
    font-weight: 550;
    letter-spacing: -0.025em;
  }

  .engineering-story__item p {
    margin: 0;
    color: var(--muted);
    font-size: 0.91rem;
    line-height: 1.75;
  }

  .engineering-story__sources {
    margin-top: 14px;
    padding: 24px;
    border: 1px solid rgba(216, 155, 176, 0.3);
    border-radius: 12px;
    background: #211d24;
  }

  .engineering-story__sources h3 {
    margin: 0 0 16px;
    font-size: 1rem;
    font-weight: 550;
  }

  .engineering-story__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .engineering-story__links a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--text);
    font-size: 0.83rem;
    line-height: 1.4;
  }

  .engineering-story__links a:hover,
  .engineering-story__links a:focus-visible {
    border-color: var(--plum);
    background: rgba(216, 155, 176, 0.1);
  }

  .engineering-story__links a span {
    color: var(--plum);
  }

  @media (max-width: 650px) {
    .engineering-story {
      margin-block: 45px;
    }

    .engineering-story__grid {
      grid-template-columns: 1fr;
    }

    .engineering-story__item {
      padding: 20px;
    }

    .engineering-story__sources {
      padding: 18px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .engineering-story__links a {
      transition:
        background-color 180ms ease,
        border-color 180ms ease;
    }
  }
</style>
